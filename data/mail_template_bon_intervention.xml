<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate : le modèle est modifiable par l'utilisateur (Paramètres > Technique > Modèles d'e-mail) -->
    <data noupdate="1">

        <record id="mail_template_bon_intervention" model="mail.template">
            <field name="name">Bon d'intervention : envoi au client</field>
            <field name="model_id" ref="model_is_sav_intervention"/>
            <field name="email_from">{{ user.company_id.email_formatted }}</field>
            <field name="partner_to">{{ object.client_id.id or '' }}</field>
            <field name="subject">Bon d'intervention N°{{ object.numero }} - {{ user.company_id.name }}</field>
            <field name="report_template_ids" eval="[(4, ref('is_jura_energie_solaire_18.action_report_bon_intervention'))]"/>
            <field name="lang">{{ object.client_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Bonjour,
        <br/><br/>
        Veuillez trouver ci-joint le bon d'intervention N°<t t-out="object.numero or ''"/>
        du <t t-out="format_date(object.date) or ''"/>.
        <br/><br/>
        Cordialement,
        <br/>
        <t t-out="user.company_id.name or ''"/>
    </p>
</div>
            </field>
        </record>

    </data>
</odoo>
