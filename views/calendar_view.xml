<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="is_view_calendar_event_form" model="ir.ui.view">
        <field name="name">is_view_calendar_event_form</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
        <field name="user_id" position="after">
                <field name="opportunity_id"/>
                <field name="is_sav_id"/>
                <field name="is_maintenance_id"/>
                <field name="is_centrale_id"/>
                <field name="is_centrale_secteur"/>
                <field name="is_equipe_id"/>
                <field name="is_client_id" readonly="1" invisible="not is_client_id"/>
                <field name="is_adresse" readonly="1" invisible="not is_adresse"/>
                <field name="is_maps_url" widget="url" string="📍 Maps" readonly="1" invisible="not is_maps_url"/>
                <field name="is_contacts_html" readonly="1" invisible="not is_contacts_html" nolabel="1"/>
            </field> 
        </field>
    </record>

    <record id="is_view_calendar_event_tree" model="ir.ui.view">
        <field name="name">is_view_calendar_event_tree</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_tree"/>
        <field name="arch" type="xml">
            <field name="partner_ids" position="after">
                <field name="is_all_attendee_partner_ids" optional="hide" widget="many2many_tags" string="Organisateur ou participant"/>
            </field>
            <field name="location" position="after">
                <field name="is_client_id" optional="show" widget="many2one_clickable"/>
                <field name="is_contacts_html" optional="hide"/>
                <field name="is_sav_id" optional="show" widget="many2one_clickable"/>
                <field name="is_maintenance_id" optional="show" widget="many2one_clickable"/>
                <field name="is_centrale_id" optional="show" widget="many2one_clickable"/>
                <field name="is_centrale_secteur" optional="show" widget="badge"/>
                <field name="is_equipe_id" optional="show" widget="many2one_clickable"/>
            </field>
        </field>
    </record>

    <record id="is_view_calendar_event_search" model="ir.ui.view">
        <field name="name">is_view_calendar_event_search</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_search"/>
        <field name="arch" type="xml">
            <field name="partner_ids" position="after">
                <field name="is_all_attendee_partner_ids" string="Organisateur ou participant"/>
            </field>
            <field name="location" position="after">
                <field name="is_sav_id"/>
                <field name="is_maintenance_id"/>
                <field name="is_centrale_id"/>
                <field name="is_centrale_secteur"/>
                <field name="is_equipe_id"/>
                <separator/>
                <filter string="Centrales GP"   name="filter_centrale_gp"   domain="[('is_centrale_secteur','=','gp')]"/>
                <filter string="Centrales RE"   name="filter_centrale_re"   domain="[('is_centrale_secteur','=','re')]"/>
                <filter string="Centrales TH"   name="filter_centrale_th"   domain="[('is_centrale_secteur','=','th')]"/>
                <filter string="Centrales SI"   name="filter_centrale_si"   domain="[('is_centrale_secteur','=','si')]"/>
                <filter string="Centrales IRVE" name="filter_centrale_irve" domain="[('is_centrale_secteur','=','irve')]"/>
                <filter string="SAV"         name="filter_sav"         domain="[('is_sav_id','!=',False)]"/>
                <filter string="Maintenance" name="filter_maintenance" domain="[('is_maintenance_id','!=',False)]"/>
            </field>
        </field>
    </record>

    <record id="is_view_calendar_event_calendar" model="ir.ui.view">
        <field name="name">is_view_calendar_event_calendar</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_calendar"/>
        <field name="arch" type="xml">
            <field name="location" position="after">
                <field name="is_sav_id" invisible="not is_sav_id" options="{'icon': 'fa fa-wrench'}"/>
                <field name="is_centrale_id" invisible="not is_centrale_id" options="{'icon': 'fa fa-bolt'}"/>
                <field name="is_centrale_secteur" invisible="not is_centrale_secteur"/>
                <field name="is_equipe_id" invisible="not is_equipe_id" options="{'icon': 'fa fa-users'}"/>
                <field name="is_client_id" invisible="not is_client_id" options="{'icon': 'fa fa-user'}"/>
                <field name="is_adresse" invisible="not is_adresse" options="{'icon': 'fa fa-map-marker'}"/>
                <field name="is_maps_url" widget="url" string="📍 Maps" invisible="not is_maps_url"/>
                <field name="is_contacts_html" invisible="not is_contacts_html"/>
            </field>
            <field name="res_model_name" position="attributes">
                <attribute name="invisible">not res_model_name or is_centrale_id or is_sav_id</attribute>
            </field>
        </field>
    </record>

    <!--
        Vue Kanban "carte de rendez-vous" façon planning journalier.
        Champs de la maquette non disponibles sur calendar.event (à ajouter si besoin) :
          - Camion / véhicule affecté à l'intervention
          - Nacelle réservée (indicateur booléen)
          - Puissance du prospect (ex: "Prospect PV 6 kWc")
        En attendant, la carte réutilise les champs déjà présents sur le modèle
        (lieu, équipe, client) pour se rapprocher au maximum du visuel demandé.
    -->
    <record id="is_view_calendar_event_kanban" model="ir.ui.view">
        <field name="name">is.view.calendar.event.kanban</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_order="start" quick_create="false">
                <field name="name"/>
                <field name="start"/>
                <field name="stop"/>
                <field name="allday"/>
                <field name="duration"/>
                <field name="location"/>
                <field name="is_adresse"/>
                <field name="is_equipe_id"/>
                <field name="is_client_id"/>
                <field name="is_sav_id"/>
                <field name="is_maintenance_id"/>
                <field name="is_centrale_id"/>
                <field name="opportunity_id"/>
                <field name="is_participants_html"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <div class="text-muted me-3" style="min-width: 56px;">
                                <div t-attf-class="{{luxon.DateTime.fromISO(record.start.raw_value).hasSame(luxon.DateTime.local(), 'day') ? 'fw-bold text-dark fs-5' : 'small fw-bold'}}" t-esc="luxon.DateTime.fromISO(record.start.raw_value).toFormat('dd/MM')"/>
                                <div t-if="!record.allday.raw_value" class="fw-bold text-dark fs-5" t-esc="luxon.DateTime.fromISO(record.start.raw_value).toFormat('HH:mm')"/>
                                <div class="small">
                                    <t t-if="record.allday.raw_value">Journée</t>
                                    <t t-else="1" t-esc="(Math.floor(record.duration.raw_value) &lt; 10 ? '0' : '') + Math.floor(record.duration.raw_value) + ':' + (Math.round((record.duration.raw_value % 1) * 60) &lt; 10 ? '0' : '') + Math.round((record.duration.raw_value % 1) * 60)"/>
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <span t-if="record.is_sav_id.raw_value" class="badge rounded-pill bg-info text-dark mb-1">SAV</span>
                                <span t-elif="record.is_maintenance_id.raw_value" class="badge rounded-pill bg-secondary mb-1">MAINTENANCE</span>
                                <span t-elif="record.is_centrale_id.raw_value" class="badge rounded-pill bg-success mb-1">POSE / CHANTIER</span>
                                <span t-elif="record.opportunity_id.raw_value" class="badge rounded-pill bg-warning text-dark mb-1">RDV COMMERCIAL</span>
                                <field name="name" class="fw-bold d-block"/>
                                <div t-if="record.is_adresse.raw_value || record.location.raw_value" class="text-muted small">
                                    <i class="fa fa-map-marker me-1" title="Adresse"/>
                                    <t t-esc="record.is_adresse.raw_value || record.location.raw_value"/>
                                </div>
                                <div t-if="record.is_equipe_id.raw_value" class="text-muted small">
                                    <i class="fa fa-users me-1" title="Équipe"/><field name="is_equipe_id"/>
                                </div>
                                <div t-if="record.is_client_id.raw_value" class="text-muted small">
                                    <i class="fa fa-user me-1" title="Client"/><field name="is_client_id"/>
                                </div>
                                <div t-if="record.is_participants_html.raw_value" class="text-muted small">
                                    <t t-out="record.is_participants_html.raw_value"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue calendrier dédiée aux centrales : couleur par équipe, filtre équipes -->
    <record id="is_view_calendar_centrale" model="ir.ui.view">
        <field name="name">is.view.calendar.centrale</field>
        <field name="model">calendar.event</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="is_view_calendar_event_calendar"/>
        <field name="arch" type="xml">
            <!-- Passer en js_class standard pour ne plus forcer la sidebar participants -->
            <xpath expr="//calendar" position="attributes">
                <attribute name="js_class">calendar</attribute>
                <attribute name="quick_create">false</attribute>
                <attribute name="color">is_equipe_id</attribute>
            </xpath>
            <!-- Supprimer le filtre sidebar sur partner_ids -->
            <xpath expr="//field[@name='partner_ids']" position="attributes">
                <attribute name="filters">0</attribute>
            </xpath>
            <!-- Activer le filtre sidebar sur is_equipe_id -->
            <xpath expr="//field[@name='is_equipe_id']" position="attributes">
                <attribute name="filters">1</attribute>
                <attribute name="options">{'block': True, 'icon': 'fa fa-users'}</attribute>
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>

    <!-- Vue Gantt (exemple) : planning par équipe des centrales GP -->
    <record id="is_view_gantt_calendar_centrale" model="ir.ui.view">
        <field name="name">is.view.gantt.calendar.centrale</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <gantt date_start="start" date_stop="stop" color="is_equipe_id" default_scale="week" default_group_by="is_equipe_id" column_count="25">
                <field name="is_centrale_id" string="Chantier" width="200"/>
                <field name="is_client_id" string="Client" width="200"/>
                <field name="is_centrale_secteur" string="Secteur" width="60"/>
            </gantt>
        </field>
    </record>

