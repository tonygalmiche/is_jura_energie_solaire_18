<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_is_sav_intervention" model="ir.sequence">
        <field name="name">Intervention SAV</field>
        <field name="code">is.sav.intervention</field>
        <field name="prefix"></field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>

    <record id="is_sav_intervention_list_view" model="ir.ui.view">
        <field name="name">is.sav.intervention.list</field>
        <field name="model">is.sav.intervention</field>
        <field name="arch" type="xml">
            <list>
                <field name="numero"/>
                <field name="date"/>
                <field name="centrale_id" optional="hide"/>
                <field name="secteur" optional="hide"/>
                <field name="client_id" optional="hide"/>
                <field name="intervenant_ids" widget="many2many_tags" optional="show"/>
                <field name="zone_id" column_invisible="1"/>
                <field name="zone_html" widget="html" string="Zone d'intervention" optional="show"/>
                <field name="description" optional="show"/>
                <field name="duree" widget="float_time" optional="show"/>
                <field name="signataire" optional="show"/>
                <field name="date_signature" optional="show"/>
                <field name="state" widget="badge" optional="show"
                    decoration-info="state == 'en_cours'"
                    decoration-success="state == 'valide'"
                />
                <field name="facturation" widget="badge" optional="show"
                    decoration-warning="facturation == 'a_facturer'"
                    decoration-muted="facturation == 'ne_pas_facturer'"
                    decoration-info="facturation == 'a_definir'"
                />
            </list>
        </field>
    </record>

    <record id="is_sav_intervention_list_view_menu" model="ir.ui.view">
        <field name="name">is.sav.intervention.list.menu</field>
        <field name="model">is.sav.intervention</field>
        <field name="arch" type="xml">
            <list>
                <field name="numero"/>
                <field name="sav_id" widget="many2one_clickable" optional="show"/>
                <field name="date"/>
                <field name="centrale_id" optional="show"/>
                <field name="secteur" optional="show"/>
                <field name="client_id" optional="show"/>
                <field name="intervenant_ids" widget="many2many_tags" optional="show"/>
                <field name="zone_id" column_invisible="1"/>
                <field name="zone_html" widget="html" string="Zone d'intervention" optional="show"/>
                <field name="description" optional="show"/>
                <field name="duree" widget="float_time" optional="show"/>
                <field name="signataire" optional="show"/>
                <field name="date_signature" optional="show"/>
                <field name="state" widget="badge" optional="show"
                    decoration-info="state == 'en_cours'"
                    decoration-success="state == 'valide'"
                />
                <field name="facturation" widget="badge" optional="show"
                    decoration-warning="facturation == 'a_facturer'"
                    decoration-muted="facturation == 'ne_pas_facturer'"
                    decoration-info="facturation == 'a_definir'"
                />
            </list>
        </field>
    </record>

    <record id="is_sav_intervention_form_view" model="ir.ui.view">
        <field name="name">is.sav.intervention.form</field>
        <field name="model">is.sav.intervention</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_valider" string="Valider" type="object" class="oe_highlight" icon="fa-check" invisible="state != 'en_cours'"/>
                    <button name="action_remettre_en_cours" string="Remettre en cours" type="object" icon="fa-undo" invisible="state != 'valide'"/>
                    <button name="action_print_bon_intervention" string="Imprimer le bon d'intervention" type="object" icon="fa-print"/>
                    <button name="action_envoyer_mail" string="Envoyer par e-mail" type="object" icon="fa-envelope"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="numero" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="sav_id" readonly="state == 'valide'"/>
                            <field name="centrale_id" readonly="1"/>
                            <field name="secteur" readonly="1"/>
                            <field name="client_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="state == 'valide'"/>
                            <field name="intervenant_ids" widget="many2many_tags" readonly="state == 'valide'"/>
                            <field name="zone_id" options="{'no_create': True, 'no_open': True}" readonly="state == 'valide'"/>
                            <field name="facturation"/>
                            <field name="duree" widget="float_time" readonly="state == 'valide'"/>
                        </group>
                    </group>
                    <group string="Description de l'intervention">
                        <field name="description" nolabel="1" readonly="state == 'valide'"/>
                    </group>
                    <group string="Fourniture">
                        <field name="fourniture_ids" nolabel="1" readonly="state == 'valide'">
                            <list editable="bottom">
                                <field name="product_id"/>
                                <field name="reference"/>
                                <field name="designation"/>
                                <field name="quantite"/>
                            </list>
                        </field>
                    </group>
                    <group string="Signature du client">
                        <group>
                            <field name="signataire" readonly="state == 'valide'"/>
                            <field name="signature" widget="signature" options="{'full_name': 'signataire'}" readonly="state == 'valide'"/>
                            <field name="date_signature" invisible="not date_signature"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="is_sav_intervention_search_view" model="ir.ui.view">
        <field name="name">is.sav.intervention.search</field>
        <field name="model">is.sav.intervention</field>
        <field name="arch" type="xml">
            <search>
                <field name="numero"/>
                <field name="sav_id"/>
                <field name="centrale_id"/>
                <field name="client_id"/>
                <field name="intervenant_ids"/>
                <field name="zone_id"/>
                <filter string="En cours" name="en_cours" domain="[('state', '=', 'en_cours')]"/>
                <filter string="Validé"   name="valide"   domain="[('state', '=', 'valide')]"/>
                <separator/>
                <filter string="Sans zone d'intervention" name="sans_zone" domain="[('zone_id', '=', False)]"/>
                <separator/>
                <filter string="À facturer"      name="a_facturer"      domain="[('facturation', '=', 'a_facturer')]"/>
                <filter string="Ne pas facturer" name="ne_pas_facturer" domain="[('facturation', '=', 'ne_pas_facturer')]"/>
                <filter string="À définir"       name="a_definir"       domain="[('facturation', '=', 'a_definir')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Zone d'intervention" name="group_by_zone"  context="{'group_by': 'zone_id'}"/>
                    <filter string="Facturation"         name="group_by_facturation" context="{'group_by': 'facturation'}"/>
                    <filter string="Etat"                name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Date"                name="group_by_date"  context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="is_sav_intervention_action" model="ir.actions.act_window">
        <field name="name">Interventions SAV</field>
        <field name="res_model">is.sav.intervention</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="is_sav_intervention_search_view"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('is_sav_intervention_list_view_menu')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('is_sav_intervention_form_view')})]"/>
    </record>

</odoo>
